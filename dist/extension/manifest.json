{
  "manifest_version": 3,
  "name": "VNPT Automation Tool (Local)",
  "version": "1.6.24",
  "description": "Local build - VNPT automation content scripts",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://hopdong.vnpt.vn/*",
    "*://mail.google.com/*",
    "*://outlook.live.com/*",
    "*://outlook.office.com/*",
    "*://outlook.office365.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://raw.githubusercontent.com/*",
    "https://*.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://firebasestorage.googleapis.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.js-loader-CJQMLVHL.js"
      ],
      "matches": [
        "*://hopdong.vnpt.vn/*",
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://hopdong.vnpt.vn/*",
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*"
      ],
      "resources": [
        "assets/profileManager-CnLURJI0.js",
        "assets/content.js-B4RKF9YB.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
