### 2. Core — Regex Rules

#### [NEW] `src/core/pdfRules.js`
Chứa toàn bộ regex rules theo từng field key. Tách riêng để dễ maintain và mở rộng:

```js
export const PDF_FIELD_RULES = [
  {
    key: 'cmnd',
    label: 'CMND/CCCD',
    patterns: [
      /(?:CMND|CCCD|Căn cước|số)\s*[:\s]+(\d{9}|\d{12})/i
    ]
  },
  {
    key: 'soDkdn',
    label: 'Mã số thuế | GPKD',
    patterns: [/(?:MST|Mã số thuế|Mã số DN)\s*[:\s]+(\d{10,13})/i]
  },
  // ... tất cả các trường
];
```

