  /* SECTION 7: PDF SCAN MODAL */
  .vnpt-pdf-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px); z-index: 9999999; display: flex;
    align-items: center; justify-content: center; }
