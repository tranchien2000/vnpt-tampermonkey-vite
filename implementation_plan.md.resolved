  export const SK_GEMINI_KEY = 'vnpt_gemini_api_key';       // API key Gemini
  export const SK_PDF_OCR_MODE = 'vnpt_pdf_ocr_mode';      // 'gemini' | 'local'
  export const PDF_CONFIDENCE_AUTO = 0.85;                  // Ngưỡng tự điền
  export const PDF_CONFIDENCE_WARN = 0.60;                  // Ngưỡng cảnh báo
