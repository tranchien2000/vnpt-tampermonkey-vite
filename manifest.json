{
  "manifest_version": 3,
  "name": "VNPT Automation Tool (Dev)",
  "version": "1.6.52",
  "action": {
    "default_title": "VNPT Tool"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://hopdong.vnpt.vn/*",
    "*://mail.google.com/*",
    "*://outlook.live.com/*",
    "*://outlook.office.com/*",
    "*://outlook.office365.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://hopdong.vnpt.vn/*",
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*"
      ],
      "js": ["src/main.js"],
      "run_at": "document_idle"
    }
  ]
}
