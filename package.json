{
  "name": "tampermonkey-vite-userscript",
  "version": "1.6.0",
  "description": "A minimal Vite setup for Tampermonkey userscripts",
  "type": "module",
  "scripts": {
    "dev": "set VITE_DEV=true && vite build --watch",
    "serve": "serve dist --cors --no-clipboard -p 8788",
    "dev:all": "concurrently \"npm run dev\" \"npm run serve\"",
    "build": "vite build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "serve": "^14.2.6",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "firebase": "^12.12.0"
  }
}
