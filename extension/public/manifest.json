{
  "manifest_version": 3,
  "name": "VNPT Automation Tool (Local)",
  "version": "1.6.24",
  "description": "Local build - VNPT automation content scripts",
  "permissions": ["storage"],
  "host_permissions": [
    "*://hopdong.vnpt.vn/*",
    "*://mail.google.com/*",
    "*://outlook.live.com/*",
    "*://outlook.office.com/*",
    "*://outlook.office365.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://raw.githubusercontent.com/*",
    "https://*.googleapis.com/*",
    "https://*.firebaseio.com/*",
    "https://firebasestorage.googleapis.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://hopdong.vnpt.vn/*",
        "*://mail.google.com/*",
        "*://outlook.live.com/*",
        "*://outlook.office.com/*",
        "*://outlook.office365.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
